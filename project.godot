; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dolores: Chronicles of the Grid"
run/main_scene="res://src/Core/Bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.04, 0.04, 0.06, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_s3tc_bptc=true
scaling_3d/scale=0.85
environment/defaults/default_clear_color=Color(0.04, 0.04, 0.06, 1)
textures/default_filters/texture_filter_3d=2
shadows/directional_shadow/soft_shadow_filter_quality=3
shadows/positional_shadow/soft_shadow_filter_quality=3
shadows/shadow_atlas/positional_shadow_atlas_16_bits=true
shader_compiler/shader_cache/use_z_prepass=true

[shader_globals]

wind_vector={
"type": "vec2",
"value": Vector2(0.3, 0.1)
}
wind_strength={
"type": "float",
"value": 0.4
}
storm_weight={
"type": "float",
"value": 0.0
}
player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
wind_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
wind_wave_time={
"type": "float",
"value": 0.0
}
