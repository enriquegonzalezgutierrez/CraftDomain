[gd_scene load_steps=5 format=3]
; ==============================================================================
; Pathfile: res://src/Infrastructure/UI/speech_bubble.tscn
; Description: Declarative UI 3D Scene representing the floating NPC Speech Bubble.
;              Purged of runtime procedural instantiations (SOLID Rule 7.1).
; Author: Enrique González Gutiérrez
; Email: enrique.gonzalez.gutierrez@gmail.com
; ==============================================================================

[ext_resource type="Script" path="res://src/Infrastructure/UI/SpeechBubble.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bubble"]
bg_color = Color(0.05, 0.05, 0.08, 0.75)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.3, 0.35, 0.5)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[sub_resource type="LabelSettings" id="LabelSettings_text"]
font_size = 14
font_color = Color(1, 0.85, 0.2, 1)
outline_size = 3
outline_color = Color(0, 0, 0, 1)

[sub_resource type="ViewportTexture" id="ViewportTexture_sprite"]
viewport_path = NodePath("SubViewport")

[node name="SpeechBubble" type="Node3D"]
script = ExtResource("1_script")

[node name="SubViewport" type="SubViewport" parent="."]
disable_3d = true
transparent_bg = true
size = Vector2i(250, 50)
render_target_update_mode = 4

[node name="BubblePanel" type="Panel" parent="SubViewport"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bubble")

[node name="BubbleLabel" type="Label" parent="SubViewport/BubblePanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
text = "◐ CLICK TO TRADE!"
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1
vertical_alignment = 1

[node name="BillboardSprite" type="Sprite3D" parent="."]
pixel_size = 0.008
billboard = 1
texture_filter = 0
texture = SubResource("ViewportTexture_sprite")